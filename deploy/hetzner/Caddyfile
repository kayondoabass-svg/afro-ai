# =============================================================================
# Caddy reverse proxy for Afro AI on Hetzner.
#
# Caddy auto-provisions Let's Encrypt certs as soon as the DNS A record for
# api.afroaigroup.com points at this server. No certbot, no cron, no manual
# renew — just works.
#
# Install location: /etc/caddy/Caddyfile  (replace whatever ships by default).
# Reload after edits:  sudo systemctl reload caddy
# =============================================================================

api.afroaigroup.com {
  encode zstd gzip

  # Cloudflare sits in front of us, so trust their X-Forwarded-For so rate
  # limiting and access logs see the real client IP, not a Cloudflare edge IP.
  trusted_proxies cloudflare
  log {
    output file /srv/afro-ai/logs/access.log {
      roll_size 50mb
      roll_keep 5
    }
    format json
  }

  # Long-running SSE streams used by the AI Builder need write timeouts off.
  reverse_proxy 127.0.0.1:3000 {
    flush_interval -1
    transport http {
      read_timeout 300s
      write_timeout 0s
      keepalive 60s
    }
  }
}

# Health check on the bare IP (Hetzner uptime monitor / status page).
:80 {
  respond /healthz "ok" 200
}
