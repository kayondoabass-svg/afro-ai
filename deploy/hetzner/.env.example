# =============================================================================
# Production environment for Afro AI on Hetzner.
# Copy to /srv/afro-ai/shared/.env on the server and fill in real values.
# Permissions: chmod 600 /srv/afro-ai/shared/.env
# =============================================================================

NODE_ENV=production
PORT=3000

# Postgres (cat /root/db_password.txt after cloud-init finishes)
DATABASE_URL=postgres://afroai:CHANGE_ME@127.0.0.1:5432/afroai

# Public URL — must match the Caddyfile domain.
APP_URL=https://afroaigroup.com
API_URL=https://api.afroaigroup.com

# Sessions
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Cloudflare R2 (object storage) — replaces Replit Object Storage.
# Run deploy/hetzner/setup-r2.sh once to create the bucket + access key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=afro-ai-uploads

# JWT shared with the Cloudflare auth worker (must match worker's JWT_SECRET)
JWT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
MAIL_FROM=Afro AI <noreply@afroaigroup.com>

# Africa's Talking (SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Pesapal (payments)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3

# Turnstile (bot protection on Express side)
TURNSTILE_SECRET_KEY=

# OpenAI / Gemini (AI Builder)
OPENAI_API_KEY=
GEMINI_API_KEY=
